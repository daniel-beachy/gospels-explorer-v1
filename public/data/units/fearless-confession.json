s of God."}}},"pairs":{"mt-lk":{"exact":58,"lemma":15,"pctA":54.1,"pctB":50.0,"run":8,"runText":"ὃ οὐκ ἀποκαλυφθήσεται καὶ κρυπτὸν ὃ οὐ γνωσθήσεται"}},"minor":[]}